{
  "name": "duma",
  "productName": "DUMA",
  "version": "1.0.0",
  "description": "ДУМА — симулятор выборной кампании (сатира)",
  "author": "MANUM GAMES",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "fonts": "node scripts/fonts.js",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/rubik-mono-one": "^5.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "games.manum.duma",
    "productName": "DUMA",
    "copyright": "© 2026 MANUM GAMES",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "license": "app/LICENSE.txt"
    }
  }
}
